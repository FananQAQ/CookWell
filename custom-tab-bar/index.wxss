.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  /* 纯色与图标铺底一致，避免渐变条与图标米色有细微色差 */
  background: #f3f0ea;
  border-top: 1rpx solid rgba(210, 200, 188, 0.4);
  box-sizing: border-box;
  /* 上略留白、下紧贴安全区，减少 Tab 内「图标下方一大块白」并让标签略靠下 */
  padding-top: 8rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 6rpx;
}

.tab-bar-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
  background-color: #f3f0ea;
  border-radius: 10rpx;
}

.tab-bar-text {
  font-size: 22rpx;
  margin-top: 4rpx;
  line-height: 1.15;
}
