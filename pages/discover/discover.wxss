.page {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 底部留白会让列表下方露出一块页面底色；Tab 由系统绘制，此处不再垫高 */
  padding-bottom: 0;
  background: linear-gradient(180deg, #faf6f0 0%, #f3f0ea 48%, #ebe6de 100%);
  min-height: 100%;
}

.custom-nav {
  flex-shrink: 0;
  width: 100%;
  background: rgba(250, 246, 240, 0.94);
  border-bottom: 1rpx solid rgba(210, 200, 188, 0.35);
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-nav-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #2a2218;
  letter-spacing: 3rpx;
}

.hero {
  flex-shrink: 0;
  padding: 16rpx 24rpx 0;
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 6rpx 8rpx 6rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(58, 42, 28, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.search-icon {
  flex-shrink: 0;
  opacity: 0.9;
}

.search-input {
  flex: 1;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #2c2419;
}

.search-ph {
  color: #b5aaa0;
}

.chips {
  flex-shrink: 0;
  width: 100%;
  margin-top: 20rpx;
  padding: 8rpx 0 14rpx;
  box-sizing: border-box;
  height: 132rpx;
}

.chips-pad {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx 0;
  white-space: nowrap;
  height: 100%;
  box-sizing: border-box;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 38rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  color: #5c5349;
  font-size: 28rpx;
  border: 1rpx solid rgba(210, 200, 188, 0.5);
  box-shadow: 0 2rpx 12rpx rgba(58, 42, 28, 0.04);
}

.chip-on {
  background: linear-gradient(135deg, #c45c26 0%, #a84a1f 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6rpx 20rpx rgba(196, 92, 38, 0.35);
  font-weight: 500;
}

.list {
  flex-shrink: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  /* scroll-view 默认透明，底部 padding 区会透出 .page 渐变，看起来像米色条 */
  background: #fff;
}

.list-pad {
  padding: 8rpx 20rpx 160rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 26rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(58, 42, 28, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  overflow: hidden;
}

.row-accent {
  width: 8rpx;
  align-self: stretch;
  margin-right: 16rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: linear-gradient(180deg, #e8b896, #c45c26);
  flex-shrink: 0;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2a2218;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.row-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.row-tag {
  font-size: 22rpx;
  color: #8b7f72;
  background: #f5f0e8;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.row-hint {
  font-size: 22rpx;
  color: #c45c26;
  opacity: 0.85;
}

.row-chev {
  flex-shrink: 0;
  font-size: 44rpx;
  color: #d4ccc2;
  font-weight: 300;
  line-height: 1;
  padding-left: 8rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx 60rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  color: #6d655c;
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #a09890;
}

.cart-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #c45c26 0%, #a84a1f 100%);
  color: #fff;
  padding: 18rpx 28rpx 18rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 36rpx rgba(168, 74, 31, 0.42);
  z-index: 95;
}

.cart-fab-hover {
  opacity: 0.92;
  transform: scale(0.98);
}

.cart-fab-label {
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.95;
}

.cart-fab-num {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

/* 须高于 custom-tab-bar（z-index:99999），否则底部抽屉被 Tab 挡住 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(32, 26, 22, 0.48);
  z-index: 100000;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 72vh;
  background: #fdfcfa;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 100001;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 48rpx rgba(42, 34, 24, 0.12);
}

.sheet-grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #dcd4c8;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #efe8df;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2a2218;
}

.sheet-link {
  color: #c45c26;
  font-size: 26rpx;
  padding: 8rpx 12rpx;
}

.sheet-body {
  flex: 1;
  height: 0;
  max-height: 42vh;
  padding: 12rpx 0;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx;
  border-bottom: 1rpx solid #f3ece4;
}

.sheet-info {
  flex: 1;
  min-width: 0;
}

.sheet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2a2218;
  display: block;
}

.sheet-sub {
  font-size: 22rpx;
  color: #958a80;
  margin-top: 8rpx;
  display: block;
}

.qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sheet-ops {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.sheet-remove {
  padding: 12rpx 8rpx 12rpx 16rpx;
  font-size: 26rpx;
  color: #c45c26;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e8dfd4;
  font-size: 32rpx;
  color: #4a4238;
}

.qty-num {
  min-width: 52rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a2218;
}

.sheet-empty {
  padding: 56rpx 40rpx;
  text-align: center;
}

.sheet-empty-title {
  display: block;
  font-size: 28rpx;
  color: #6d655c;
  margin-bottom: 12rpx;
}

.sheet-empty-sub {
  display: block;
  font-size: 24rpx;
  color: #a09890;
  line-height: 1.5;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx 32rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 20rpx;
  line-height: 2.35;
  font-weight: 500;
}

.btn.primary {
  background: linear-gradient(135deg, #c45c26 0%, #a84a1f 100%);
  color: #fff;
  border: none;
}

.btn.secondary {
  background: #fff;
  color: #4a4238;
  border: 1rpx solid #e0d5c8;
}

.btn[disabled] {
  opacity: 0.4;
}

button.btn::after {
  border: none;
}
