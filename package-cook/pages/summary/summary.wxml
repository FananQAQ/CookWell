<view class="page safe-bottom">
  <view class="seg">
    <view
      class="seg-item {{viewMode === 'byDish' ? 'on' : ''}}"
      data-m="byDish"
      bindtap="setMode"
    >菜品图</view>
    <view
      class="seg-item {{viewMode === 'merged' ? 'on' : ''}}"
      data-m="merged"
      bindtap="setMode"
    >合并清单</view>
  </view>

  <view class="state" wx:if="{{loading}}">正在加载…</view>
  <view class="state err" wx:if="{{err}}">{{err}}</view>

  <block wx:if="{{!loading && !err}}">
    <block wx:if="{{viewMode === 'byDish'}}">
      <scroll-view
        class="dish-nav"
        scroll-x
        enable-flex
        scroll-with-animation
        scroll-into-view="{{navScrollInto}}"
      >
        <view
          id="nav-{{index}}"
          class="dish-nav-item {{dishIndex === index ? 'on' : ''}}"
          wx:for="{{byDish}}"
          wx:key="name"
          data-i="{{index}}"
          bindtap="onNavTap"
        >{{item.name}}</view>
      </scroll-view>

      <swiper
        class="dish-swiper"
        current="{{dishIndex}}"
        bindchange="onSwiperChange"
        duration="280"
      >
        <swiper-item wx:for="{{byDish}}" wx:key="name">
          <scroll-view class="dish-slide" scroll-y>
            <image
              class="dish-cover"
              src="{{item.coverUrl}}"
              mode="widthFix"
              data-i="{{index}}"
              binderror="onCoverErr"
            />
          </scroll-view>
        </swiper-item>
      </swiper>
    </block>

    <scroll-view class="body" scroll-y wx:else>
      <view class="hint">合并清单会把同物异名归并（如蒜片/蒜末→大蒜）。组内仍保留各菜原文用量，请人工核对「约、可选」等表述。点一行可标记「已买」。</view>
      <view class="card" wx:for="{{merged}}" wx:key="key">
        <text class="merge-key">{{item.key}}</text>
        <view
          class="merge-row {{en.purchased ? 'purchased' : ''}}"
          wx:for="{{item.entries}}"
          wx:for-item="en"
          wx:for-index="ei"
          wx:key="_id"
          data-id="{{en._id}}"
          bindtap="toggleMergedPurchased"
        >
          <view class="merge-row-inner">
            <text class="merge-check" wx:if="{{en.purchased}}">✓</text>
            <text class="merge-check off" wx:else>○</text>
            <view class="merge-text">
              <text class="merge-dish">{{en.dish}}</text>
              <text class="merge-line">{{en.line}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>
</view>
