<view class="page safe-bottom">
  <view class="seg">
    <view
      class="seg-item {{viewMode === 'byDish' ? 'on' : ''}}"
      data-m="byDish"
      bindtap="setMode"
    >按菜品</view>
    <view
      class="seg-item {{viewMode === 'merged' ? 'on' : ''}}"
      data-m="merged"
      bindtap="setMode"
    >合并清单</view>
  </view>

  <view class="state" wx:if="{{loading}}">正在拉取菜谱并汇总…</view>
  <view class="state err" wx:if="{{err}}">{{err}}</view>

  <scroll-view class="body" scroll-y wx:if="{{!loading && !err}}">
    <block wx:if="{{viewMode === 'byDish'}}">
      <view class="card" wx:for="{{byDish}}" wx:key="name">
        <view class="card-head">
          <text class="dish-title">{{item.name}}</text>
          <text class="dish-sub">{{item.categoryLabel}} · ×{{item.servings}}</text>
        </view>
        <view class="block" wx:if="{{item.toolLines.length}}">
          <text class="bh">原料与工具</text>
          <text class="li" wx:for="{{item.toolLines}}" wx:for-item="t" wx:key="*this">· {{t}}</text>
        </view>
        <view class="block" wx:if="{{item.calcLines.length}}">
          <text class="bh">计算用量（已乘份数）</text>
          <text class="li" wx:for="{{item.calcLines}}" wx:for-item="c" wx:key="*this">· {{c}}</text>
        </view>
        <view class="more" data-name="{{item.name}}" data-cat="{{item.categoryKey}}" bindtap="openDetail">查看做法</view>
      </view>
    </block>

    <block wx:else>
      <view class="hint">以下为按食材关键字分组的合并视图；带「约、可选」等字样的行仍以原文展示，请人工核对。点一行可标记「已买」，将显示删除线。</view>
      <view class="card" wx:for="{{merged}}" wx:key="key">
        <text class="merge-key">{{item.key}}</text>
        <view
          class="merge-row {{en.purchased ? 'purchased' : ''}}"
          wx:for="{{item.entries}}"
          wx:for-item="en"
          wx:for-index="ei"
          wx:key="_id"
          data-id="{{en._id}}"
          bindtap="toggleMergedPurchased"
        >
          <view class="merge-row-inner">
            <text class="merge-check" wx:if="{{en.purchased}}">✓</text>
            <text class="merge-check off" wx:else>○</text>
            <view class="merge-text">
              <text class="merge-dish">{{en.dish}}</text>
              <text class="merge-line">{{en.line}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
