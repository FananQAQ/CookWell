.page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf8f5;
  box-sizing: border-box;
}

.seg {
  display: flex;
  margin: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #eee9e2;
  overflow: hidden;
  flex-shrink: 0;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
}

.seg-item.on {
  background: #fff3e8;
  color: #c45c26;
  font-weight: 600;
}

.state {
  padding: 60rpx;
  text-align: center;
  color: #888;
}

.state.err {
  color: #b33;
}

.dish-nav {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 0 16rpx 12rpx;
  height: 72rpx;
}

.dish-nav-item {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border: 1rpx solid #eee9e2;
  border-radius: 999rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-nav-item.on {
  color: #c45c26;
  background: #fff3e8;
  border-color: #f0d4c0;
  font-weight: 600;
}

.dish-swiper {
  flex: 1;
  height: 0;
  min-height: 400rpx;
}

.dish-slide {
  height: 100%;
  box-sizing: border-box;
}

.dish-cover {
  width: 100%;
  display: block;
  background: #ebe4da;
  min-height: 70vh;
  opacity: 0;
  transition: opacity 0.18s ease-out;
}

.dish-cover.ready {
  opacity: 1;
}

.body {
  flex: 1;
  height: 0;
  padding: 0 16rpx 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee9e2;
}

.merge-key {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.merge-row {
  padding: 12rpx 0;
  border-top: 1rpx solid #f5f2ec;
}

.merge-row-inner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
}

.merge-check {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 26rpx;
  color: #c45c26;
  line-height: 1.35;
}

.merge-check.off {
  color: #c4bbb0;
}

.merge-text {
  flex: 1;
  min-width: 0;
}

.merge-dish {
  font-size: 22rpx;
  color: #999;
  display: block;
}

.merge-line {
  font-size: 26rpx;
  color: #333;
  margin-top: 4rpx;
}

.merge-row.purchased .merge-dish,
.merge-row.purchased .merge-line {
  text-decoration: line-through;
  color: #a8a098;
}
