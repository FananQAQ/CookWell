.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: #faf8f5;
}

.hero {
  background: #eae6df;
  min-height: 200rpx;
}

.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.hero-tip {
  color: #9a9590;
  font-size: 24rpx;
}

.cover {
  width: 100%;
  display: block;
  min-height: 200rpx;
}

.state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #888;
}

.state.err {
  color: #b33;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee9e2;
  z-index: 20;
}

.bar-qty {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qbtn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f2ec;
  border-radius: 12rpx;
  font-size: 36rpx;
}

.qnum {
  min-width: 48rpx;
  text-align: center;
  font-size: 30rpx;
}

.add-btn {
  flex: 1;
  background: #c45c26;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.4;
}
