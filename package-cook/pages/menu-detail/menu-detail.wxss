.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #faf6f0 0%, #f3f0ea 48%, #ebe6de 100%);
  box-sizing: border-box;
}

.head {
  padding: 16rpx 24rpx 8rpx;
}

.title-card {
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #eee9e2;
  padding: 28rpx 26rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(58, 42, 28, 0.05);
}

.h1 {
  font-size: 36rpx;
  font-weight: 600;
  color: #2a2218;
  line-height: 1.35;
}

.title-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0ebe4;
}

.sub {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a8278;
}

.edit-pill {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #faf7f2 0%, #f3efe8 100%);
  border: 1rpx solid #e5ddd2;
}

.edit-pill-hover {
  opacity: 0.88;
}

.edit-pill-icon {
  font-size: 22rpx;
  color: #c45c26;
  line-height: 1;
}

.edit-pill-text {
  font-size: 24rpx;
  color: #5c544c;
  font-weight: 500;
}

.actions {
  padding: 12rpx 24rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.btn {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.btn.primary {
  background: linear-gradient(135deg, #c45c26 0%, #a84a1f 100%);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(168, 74, 31, 0.28);
}

.btn-primary-hover {
  opacity: 0.92;
}

.btn.danger.plain {
  background: #fff;
  color: #a85a52;
  border: 1rpx solid #e5d4cf;
  box-shadow: 0 4rpx 16rpx rgba(58, 42, 28, 0.06);
}

.btn-plain-hover {
  background: #faf7f5 !important;
}

button.btn::after {
  border: none;
}

.list {
  /* 避开 iOS scroll-view 在 flex+height:0 下高度为 0 */
  height: calc(100vh - 360rpx);
  min-height: 40vh;
  padding: 4rpx 16rpx 32rpx;
  box-sizing: border-box;
}

.row {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #eee9e2;
  box-shadow: 0 4rpx 18rpx rgba(58, 42, 28, 0.04);
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2a2218;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #958a80;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 32rpx;
}
